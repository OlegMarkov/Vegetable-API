    <PackageReference Include="AutoMapper.Extensions.Microsoft.DependencyInjection" Version="11.0.0" />
    <PackageReference Include="CDB.Captcha" Version="1.0.2" />
    <PackageReference Include="libphonenumber-csharp" Version="8.12.52" />
    <PackageReference Include="Macross.Json.Extensions" Version="2.2.0" />
    <PackageReference Include="Microsoft.AspNet.WebApi.Client" Version="5.2.9" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="6.0.5" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="6.0.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="6.0.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="6.0.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="6.0.0" />
    <PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="6.0.5" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="6.0.4" />
	<PackageReference Include="RestSharp" Version="107.3.0" />
	<PackageReference Include="Telegram.Bot" Version="17.0.0" />
	<PackageReference Include="Telesign" Version="2.2.2" />
	<PackageReference Include="TimeZoneConverter" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <DotNetCliToolReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Tools" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="CleanDeployArgs.ps1">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="logs\ReadMe.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\images\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vegetable.Core\Vegetable.Core.csproj" />
    <ProjectReference Include="..\Vegetable.Entities\Vegetable.Entities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="fonts\Candara.ttf" />
    <Resource Include="fonts\impact.ttf" />
    <Resource Include="fonts\monbaiti.ttf" />
    <Resource Include="fonts\simsun.ttf" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\fonts\Candara.ttf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\fonts\impact.ttf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\fonts\monbaiti.ttf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\fonts\simsun.ttf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\images\lemon.jpg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <!--
    Strips ' -argFile IISExeLauncherArgs.txt' out of the generated web.config.
    That is an IIS concern end to end: web.config means nothing off IIS, and
    _TransformWebConfig only runs on an IIS-shaped publish.

    Conditioned on Windows because the Exec shells out to powershell.exe, which
    fails with exit 127 on a Linux build host and takes the whole publish with
    it. Behaviour on Windows is unchanged.
  -->
  <Target Name="CleanDeployArgs" AfterTargets="_TransformWebConfig" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="powershell.exe –NonInteractive –ExecutionPolicy Unrestricted  –command &quot;&amp; { &amp;'$(PublishDir)CleanDeployArgs.ps1'  '$(PublishDir)'}&quot;" />
  </Target>
</Project>
